# Only needed for Streamlit Community Cloud deployment, where secrets are
# set via the app's dashboard (Settings -> Secrets), which populates this
# same TOML format under the hood -- you paste this content there, you
# don't create this file on the server yourself.
#
# For local development, use .env instead (see .env.example), app.py reads
# from GROQ_API_KEY in the environment first and only falls back to
# st.secrets if that's unset.
GROQ_API_KEY = "your_groq_api_key_here"
